AI_APP_NAME=DragBizz AI
AI_ENVIRONMENT=development
AI_HOST=0.0.0.0
AI_PORT=4004
AI_LOG_LEVEL=INFO
AI_API_V1_PREFIX=/api/v1
AI_DOCS_ENABLED=true
AI_CORS_ORIGINS=["http://dragbizz.local","http://localhost:3001"]
AI_RETAILER_SERVICE_URL=http://dragbizz.local/retailer
AI_AUTH_SERVICE_URL=http://dragbizz.local/auth
AI_UTILITY_SERVICE_URL=http://dragbizz.local/utility
AI_REQUEST_TIMEOUT_SECONDS=10
AI_JWT_ISSUER=DragBizz-auth
AI_JWT_AUDIENCE=DRAGBIZZ
AI_JWT_ALGORITHMS=["RS256"]
AI_JWKS_CACHE_TTL_SECONDS=3600
AI_JWT_CLOCK_SKEW_SECONDS=60
AI_ACTIVE_PROVIDER=openai_compatible
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o-mini
AI_CHAT_MAX_TOKENS=1024
AI_CHAT_SYNTHESIS_MAX_TOKENS=512
AI_CHAT_MAX_TOOL_ROUNDS=3
AI_CHAT_TEMPERATURE=0.2
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_QDRANT_URL=http://localhost:6333
AI_QDRANT_API_KEY=
AI_QDRANT_COLLECTION=dragbizz_docs
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_RAG_TOP_K=5
AI_RAG_SCORE_THRESHOLD=0.3
AI_RAG_CONTEXT_MAX_TOKENS=2000
# Smaller docs budget for action/live turns (bill/sale/stock); how-to keeps full.
AI_RAG_CONTEXT_MAX_TOKENS_ACTION=512
AI_INPUT_GUARD_MODE=log
AI_OUTPUT_GUARD_MODE=log
AI_SESSION_TTL_SECONDS=1800
AI_SESSION_MAX_TURNS=10
AI_SESSION_HISTORY_MAX_TOKENS=2000
AI_IDEMPOTENCY_TTL_SECONDS=86400
AI_CONFIRMATION_TTL_SECONDS=300
AI_CHAT_INPUT_USD_PER_MILLION_TOKENS=0.15
AI_CHAT_OUTPUT_USD_PER_MILLION_TOKENS=0.60
AI_REDIS_URL=
# Extra models platform admins may activate (default model always allowed)
AI_OPENAI_ALLOWED_MODELS=[]
# Per-store daily hard caps; 0 disables
AI_TENANT_DAILY_TOKEN_CAP=0
AI_TENANT_DAILY_COST_CAP_USD=0
# Append-only tool-execution audit trail (empty disables)
AI_AUDIT_TRAIL_PATH=data/tool_audit.jsonl