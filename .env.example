AI_APP_NAME=DragBizz AI
AI_ENVIRONMENT=development
AI_HOST=0.0.0.0
AI_PORT=4004
AI_LOG_LEVEL=INFO
AI_API_V1_PREFIX=/api/v1
AI_DOCS_ENABLED=true
AI_CORS_ORIGINS=["http://dragbizz.local","http://localhost:3001"]
# Nginx base. Service paths (/retailer, /auth, /utility) are appended in code.
AI_BASE_URL=http://dragbizz.local
AI_REQUEST_TIMEOUT_SECONDS=10
AI_JWT_ISSUER=DragBizz-auth
AI_JWT_AUDIENCE=DRAGBIZZ
AI_JWT_ALGORITHMS=["RS256"]
AI_JWKS_CACHE_TTL_SECONDS=3600
AI_JWT_CLOCK_SKEW_SECONDS=60
AI_ACTIVE_PROVIDER=openai_compatible
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o-mini
AI_CHAT_MAX_TOKENS=1024
AI_CHAT_SYNTHESIS_MAX_TOKENS=512
AI_CHAT_MAX_TOOL_ROUNDS=3
AI_CHAT_TEMPERATURE=0.2
AI_PROVIDER_TIMEOUT_SECONDS=30
# FAQ / small talk. Also the fallback when OpenAI does not respond.
CHEAPER_INFERENCE_API_KEY=
CHEAPER_INFERENCE_BASE_URL=https://api.cheaperinference.com/v1
CHEAPER_INFERENCE_MODEL=deepseek-v4.1-flash
CHEAPER_INFERENCE_TEMPERATURE=0.2
CHEAPER_INFERENCE_MAX_TOKENS=1024
AI_QDRANT_URL=http://localhost:6333
AI_QDRANT_API_KEY=
AI_QDRANT_COLLECTION=dragbizz_docs
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_RAG_TOP_K=5
AI_RAG_SCORE_THRESHOLD=0.3
# FAQ / how-to / both docs block (~800–1000).
AI_RAG_CONTEXT_MAX_TOKENS=1000
# Smaller docs budget for pure action/live turns.
AI_RAG_CONTEXT_MAX_TOKENS_ACTION=512
# FAQ retrieval + docs-block cache TTL (0 disables). Redis when AI_REDIS_URL set.
AI_RAG_CACHE_TTL_SECONDS=1800
AI_INPUT_GUARD_MODE=log
AI_OUTPUT_GUARD_MODE=log
AI_SESSION_TTL_SECONDS=1800
AI_SESSION_MAX_TURNS=5
AI_SESSION_HISTORY_MAX_TOKENS=1200
AI_IDEMPOTENCY_TTL_SECONDS=86400
AI_CONFIRMATION_TTL_SECONDS=300
# Durable chat history on existing Mongo (dedicated DB dragbizz_ai).
# Example: mongodb://USER:PASS@dragbizz.local:27017/dragbizz_ai?authSource=admin&replicaSet=rs0
AI_MONGODB_URI=
# Centralized PricingConfig rates (stamped with AI_PRICING_VERSION on cost logs)
AI_CHAT_INPUT_USD_PER_MILLION_TOKENS=0.15
AI_CHAT_OUTPUT_USD_PER_MILLION_TOKENS=0.60
AI_EMBEDDING_USD_PER_MILLION_TOKENS=0.02
AI_PRICING_VERSION=v1
# Required in production (AI_ENVIRONMENT=production). Shared rate limits,
# concurrency leases, confirmations, idempotency, and usage counters.
AI_REDIS_URL=
# Fixed-window rate limits (userId+storeId). Boundary bursts up to ~2x accepted.
AI_CHAT_RATE_PER_MINUTE=30
AI_CONFIRM_RATE_PER_MINUTE=20
# Lease concurrency per userId+storeId (0 disables)
AI_MAX_CONCURRENT_CHATS_PER_STORE_USER=2
AI_MAX_CONCURRENT_CONFIRMS_PER_STORE_USER=2
AI_CONCURRENCY_LEASE_SECONDS=60
# Per-request work budget (separate from session/RAG context size)
AI_MAX_MODEL_CALLS=4
AI_MAX_TOOL_CALLS=8
AI_MAX_ESTIMATED_INPUT_TOKENS=12000
AI_MAX_ESTIMATED_OUTPUT_TOKENS=4000
AI_REQUEST_DEADLINE_SECONDS=55
# Provider circuit breaker
AI_BREAKER_FAILURE_THRESHOLD=5
AI_BREAKER_COOLDOWN_SECONDS=30
# Extra models platform admins may activate (default model always allowed)
AI_OPENAI_ALLOWED_MODELS=[]
# Per-store daily hard caps; 0 disables. Set non-zero in production.
AI_TENANT_DAILY_TOKEN_CAP=0
AI_TENANT_DAILY_COST_CAP_USD=0
# Append-only tool-execution audit trail (empty disables)
AI_AUDIT_TRAIL_PATH=data/tool_audit.jsonl