# Environment
environment=development
debug=true

# Server
base_url=http://localhost
server_url=
allowed_origins=

# OpenRouter AI (required)
openrouter_api_key=
openrouter_http_referer=
openrouter_title=

# Redis
redis_host=localhost
redis_port=6379
redis_password=
redis_db=0
session_ttl=300

# JWT (must match auth service)
jwt_issuer=DragBizz-auth
jwt_algorithm=RS256
jwt_audience=VOICE-AI,RETAILER

# Timeouts and limits
http_timeout=30
ai_request_timeout=30
rate_limit_enabled=true
rate_limit_per_minute=60
rate_limit_per_hour=1000
ai_response_cache_ttl=300
token_verify_cache_ttl=300

# Features
enable_request_id=true
subscription_enabled=true

# Cache subscription/feature access result to avoid frequent API hits (seconds)
# Default: 600 (10 minutes)
ai_feature_access_cache_ttl=600
ai_feature_access_denied_cache_ttl=600

# Internal service auth (Voice-AI to Retailer)
# Must match INTERNAL_SERVICE_SECRET in retailer service. Optional but recommended for production.
internal_service_secret=
