# Shared environment template for development and production.
# Dev/test: copy to .env. Production: copy to .env.production.
# Set environment mode, credentials and endpoints for the target server.

# Docker host publish only (container still listens on 4004 internally)
HOST_HTTP_PORT=8004

# Browser access and Nginx-routed services
AI_CORS_ORIGINS=["https://dragbizz.io","http://dragbizz.local","http://localhost:3001"]
AI_BASE_URL=http://dragbizz.local

# Authentication (JWKS is derived from AI_BASE_URL + /auth)
AI_JWT_ISSUER=DragBizz-auth
AI_JWT_AUDIENCE=DRAGBIZZ
AI_JWT_ALGORITHMS=["RS256"]

# AI providers. Switch chat with AI_ACTIVE_PROVIDER:
#   google_ai | openai_compatible | cheaper_inference
AI_ACTIVE_PROVIDER=google_ai
AI_OPENAI_API_KEY=
AI_GOOGLE_API_KEY=
AI_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_GOOGLE_MODEL=gemini-3.5-flash
CHEAPER_INFERENCE_API_KEY=

# Optional durable conversation history
AI_MONGODB_URI=

# Prompt safety
AI_INPUT_GUARD_MODE=enforce
AI_OUTPUT_GUARD_MODE=enforce

# Middleware.io Observability
MW_UID=
MW_API_KEY=
MW_PROJECT_NAME=dragbizz-local
OTEL_SERVICE_NAME=dragbizz-brain
OTEL_DEPLOYMENT_ENVIRONMENT=development

# Copy generated credentials; never use the default Redis user.
AI_REDIS_URL=redis://brain_user:<generated-brain-password>@redis:6379/0

# Additional runtime settings
AI_ENVIRONMENT=development
